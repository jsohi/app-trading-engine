# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/worktrees/
.claude/scheduled_tasks.lock

# Node (web-ui)
node_modules/
dist/
playwright-report/
playwright-report-full-stack/
test-results/
storybook-static/
coverage/

# Local dev secrets / certs (web-ui)
web-ui/.env.local
web-ui/.dev-certs/
**/websocket-server-dev.local.yaml

# Log output (Log4j2)
logs/

# JVM crash logs
hs_err_pid*.log

# E2E test runtime artifacts (not the checked-in test data or source code).
# Note: only specific subdirs are ignored — e2e/config/*.tmpl (committed templates
# rendered at runtime by scripts/full-stack-e2e.sh) and e2e/* committed test data
# (currently none) remain tracked. The full-stack overlay rendered files are
# explicitly ignored below.
e2e/cluster-data*/
e2e/logs/
e2e/config/websocket-server-e2e.yaml
e2e/config/websocket-server-multi-issuer.yaml
# Catch e2e/ subdirs created beneath any module (launcher/e2e/, integration-tests/e2e/,
# etc. that may appear when running launcher tests from a module subdirectory).
**/e2e/cluster-data/
**/e2e/cluster-data-*/
**/e2e/logs/
fix-logs/

# JCStress raw run artefacts (per-run binary, large, not source-controlled).
# HTML report under websocket-server/build/reports/jcstress/ is ignored via build/.
**/jcstress-results-*.bin.gz

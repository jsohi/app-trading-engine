<?xml version="1.0" encoding="UTF-8"?>
<config>
  <appender name="console"
            factory="com.epam.deltix.gflog.core.appender.ConsoleAppenderFactory"
            bufferCapacity="262144">
    <layout template="%d{yyyy-MM-dd HH:mm:ss,SSSSSS} [%t] %-5p %c{36} - %m%n" zoneId="UTC"/>
  </appender>

  <appender name="file"
            factory="com.epam.deltix.gflog.core.appender.DailyRollingFileAppenderFactory"
            file="logs/pricing-service.log"
            append="true"
            bufferCapacity="8388608"
            maxFileSize="104857600"
            maxFiles="30">
    <layout template="%d{yyyy-MM-dd HH:mm:ss,SSSSSS} [%t] %-5p %c{36} - %m%n" zoneId="UTC"/>
  </appender>

  <logger name="com.trading" level="INFO"/>
  <logger level="WARN">
    <appender-ref ref="console"/>
    <appender-ref ref="file"/>
  </logger>

  <service overflowStrategy="DISCARD" bufferCapacity="4194304"/>
</config>

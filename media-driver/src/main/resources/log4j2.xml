<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="warn">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}{GMT+0} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
    <RollingRandomAccessFile name="File"
                             fileName="logs/media-driver.log"
                             filePattern="logs/media-driver-%d{yyyy-MM-dd}-%i.log">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS}{GMT+0} [%t] %-5level %logger{36} - %msg%n"/>
      <Policies>
        <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
        <SizeBasedTriggeringPolicy size="100MB"/>
      </Policies>
      <DefaultRolloverStrategy max="30"/>
    </RollingRandomAccessFile>
  </Appenders>
  <Loggers>
    <AsyncLogger name="com.trading" level="info" includeLocation="false"/>
    <AsyncLogger name="io.aeron" level="warn" includeLocation="false"/>
    <AsyncRoot level="info" includeLocation="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </AsyncRoot>
  </Loggers>
</Configuration>

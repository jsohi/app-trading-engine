{
  "uid": "trading-pricing-service",
  "title": "Trading Engine — Pricing Service",
  "tags": ["trading-engine", "pricing", "marketdata", "phase3"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "symbol",
        "type": "query",
        "label": "Symbol",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(pricing_marketdata_ticks_published_total, symbol)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Market-data ticks/sec per symbol",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 0, "w": 16, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (symbol) (rate(pricing_marketdata_ticks_published_total{symbol=~\"${symbol}\"}[1m]))",
          "legendFormat": "{{symbol}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total tick rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pricing_marketdata_ticks_published_total[1m]))",
          "legendFormat": "ticks/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reject rate (last 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pricing_marketdata_rejects_total[5m])) / clamp_min(sum(rate(pricing_marketdata_ticks_published_total[5m])), 1)",
          "legendFormat": "reject ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rejects by reason",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(pricing_marketdata_rejects_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "MarketDataTickPublished latency p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pricing_marketdata_publish_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 publish latency"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pricing_marketdata_publish_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Feed state transitions (LIVE / QUIET / STALE)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (rate(websocket_marketdata_feed_state_transitions_total[1m]))",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Snapshot dedupe / timeout (last 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(websocket_marketdata_snapshot_deduped_total[5m]))",
          "legendFormat": "deduped"
        },
        {
          "refId": "B",
          "expr": "sum(increase(websocket_marketdata_snapshot_timeout_total[5m]))",
          "legendFormat": "timeouts"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    }
  ]
}

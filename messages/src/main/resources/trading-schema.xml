<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.trading.engine.messages.sbe"
                   id="1"
                   version="1"
                   semanticVersion="0.1.0"
                   description="Trading Engine SBE Schema"
                   byteOrder="littleEndian">

    <!-- ======================== Types ======================== -->

    <types>
        <composite name="messageHeader"
                   description="Message identifiers and length of message root.">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId"  primitiveType="uint16"/>
            <type name="schemaId"    primitiveType="uint16"/>
            <type name="version"     primitiveType="uint16"/>
        </composite>

        <composite name="groupSizeEncoding"
                   description="Repeating group dimensions.">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup"  primitiveType="uint16"/>
        </composite>

        <!-- Fixed-length string types -->
        <type name="ClOrdID"     primitiveType="char" length="20" description="Client order identifier"/>
        <type name="OrderID"     primitiveType="char" length="20" description="Exchange order identifier"/>
        <type name="ExecID"      primitiveType="char" length="20" description="Execution identifier"/>
        <type name="QuoteReqID"  primitiveType="char" length="20" description="Quote request identifier"/>
        <type name="QuoteID"     primitiveType="char" length="20" description="Quote identifier"/>
        <type name="Symbol"      primitiveType="char" length="8"  description="Instrument symbol"/>
        <type name="Account"     primitiveType="char" length="16" description="Account code"/>
        <type name="Text"        primitiveType="char" length="64" description="Free text field"/>
        <type name="OrigClOrdID" primitiveType="char" length="20" description="Original client order identifier"/>

        <!-- Enums -->
        <enum name="SideEnum" encodingType="uint8" description="FIX tag 54">
            <validValue name="Buy"  description="Buy">1</validValue>
            <validValue name="Sell" description="Sell">2</validValue>
        </enum>

        <enum name="OrdTypeEnum" encodingType="uint8" description="FIX tag 40">
            <validValue name="Market"           description="Market order">1</validValue>
            <validValue name="Limit"            description="Limit order">2</validValue>
            <validValue name="PreviouslyQuoted" description="Previously quoted (RFQ accept)">3</validValue>
        </enum>

        <enum name="TimeInForceEnum" encodingType="uint8" description="FIX tag 59">
            <validValue name="Day" description="Day order">0</validValue>
            <validValue name="GTC" description="Good till cancel">1</validValue>
            <validValue name="IOC" description="Immediate or cancel">3</validValue>
            <validValue name="FOK" description="Fill or kill">4</validValue>
        </enum>

        <enum name="ExecTypeEnum" encodingType="uint8" description="FIX tag 150">
            <validValue name="New"      description="New order">0</validValue>
            <validValue name="Canceled"  description="Order canceled">4</validValue>
            <validValue name="Rejected" description="Order rejected">8</validValue>
            <validValue name="Fill"     description="Order filled">15</validValue>
        </enum>

        <enum name="OrdStatusEnum" encodingType="uint8" description="FIX tag 39">
            <validValue name="New"              description="New">0</validValue>
            <validValue name="PartiallyFilled"  description="Partially filled">1</validValue>
            <validValue name="Filled"           description="Filled">2</validValue>
            <validValue name="Canceled"          description="Canceled">4</validValue>
            <validValue name="Rejected"         description="Rejected">8</validValue>
        </enum>

        <enum name="QuoteStatusEnum" encodingType="uint8" description="FIX tag 297">
            <validValue name="Accepted" description="Quote accepted">0</validValue>
            <validValue name="Canceled"  description="Quote canceled">1</validValue>
            <validValue name="Rejected" description="Quote rejected">5</validValue>
            <validValue name="Expired"  description="Quote expired">7</validValue>
        </enum>

        <enum name="QuoteRejectReasonEnum" encodingType="uint8" description="FIX tag 300">
            <validValue name="UnknownSymbol"     description="Unknown symbol">1</validValue>
            <validValue name="ExchangeClosed"    description="Exchange closed">2</validValue>
            <validValue name="QuoteExceedsLimit" description="Quote exceeds limit">3</validValue>
            <validValue name="TooLateToEnter"    description="Too late to enter">4</validValue>
            <validValue name="InvalidPrice"      description="Invalid price">5</validValue>
            <validValue name="Other"             description="Other reason">99</validValue>
        </enum>
    </types>

    <!-- ======================== Command Messages (templateId 1-10) ======================== -->

    <!-- QuoteRequest: FIX 35=R -->
    <sbe:message name="QuoteRequest" id="1" semanticType="R"
                 description="Request for quote from client">
        <field name="quoteReqId"   id="131" type="QuoteReqID"/>
        <field name="symbol"       id="55"  type="Symbol"/>
        <field name="side"         id="54"  type="SideEnum"/>
        <field name="orderQty"     id="38"  type="int64" description="Requested quantity, fixed-point 10^-8"/>
        <field name="account"      id="1"   type="Account"/>
        <field name="transactTime" id="60"  type="uint64" description="Epoch nanos"/>
    </sbe:message>

    <!-- Quote: FIX 35=S -->
    <sbe:message name="Quote" id="2" semanticType="S"
                 description="Quote response to client">
        <field name="quoteReqId"   id="131" type="QuoteReqID"/>
        <field name="quoteId"      id="117" type="QuoteID"/>
        <field name="symbol"       id="55"  type="Symbol"/>
        <field name="side"         id="54"  type="SideEnum"/>
        <field name="bidPx"        id="132" type="int64" description="Bid price, fixed-point 10^-8"/>
        <field name="offerPx"      id="133" type="int64" description="Offer price, fixed-point 10^-8"/>
        <field name="bidSize"      id="134" type="int64" description="Bid quantity, fixed-point 10^-8"/>
        <field name="offerSize"    id="135" type="int64" description="Offer quantity, fixed-point 10^-8"/>
        <field name="transactTime" id="60"  type="uint64"/>
        <field name="quoteStatus"  id="297" type="QuoteStatusEnum"/>
        <field name="text"         id="58"  type="Text"/>
    </sbe:message>

    <!-- QuoteRequestReject: FIX 35=AG -->
    <sbe:message name="QuoteRequestReject" id="3" semanticType="AG"
                 description="Quote request rejection">
        <field name="quoteReqId"         id="131" type="QuoteReqID"/>
        <field name="quoteRejectReason"  id="300" type="QuoteRejectReasonEnum"/>
        <field name="symbol"             id="55"  type="Symbol"/>
        <field name="side"               id="54"  type="SideEnum"/>
        <field name="transactTime"       id="60"  type="uint64"/>
        <field name="text"               id="58"  type="Text"/>
    </sbe:message>

    <!-- NewOrderSingle: FIX 35=D -->
    <sbe:message name="NewOrderSingle" id="4" semanticType="D"
                 description="New order single — also used for AcceptQuote (ordType=PreviouslyQuoted, quoteId set)">
        <field name="clOrdId"      id="11"  type="ClOrdID"/>
        <field name="quoteId"      id="117" type="QuoteID" description="Reference to accepted quote (empty if not from RFQ)"/>
        <field name="symbol"       id="55"  type="Symbol"/>
        <field name="side"         id="54"  type="SideEnum"/>
        <field name="ordType"      id="40"  type="OrdTypeEnum"/>
        <field name="price"        id="44"  type="int64" description="Order price, fixed-point 10^-8"/>
        <field name="orderQty"     id="38"  type="int64" description="Order quantity, fixed-point 10^-8"/>
        <field name="timeInForce"  id="59"  type="TimeInForceEnum"/>
        <field name="transactTime" id="60"  type="uint64"/>
        <field name="account"      id="1"   type="Account"/>
    </sbe:message>

    <!-- ExecutionReport: FIX 35=8 -->
    <sbe:message name="ExecutionReport" id="5" semanticType="8"
                 description="Execution report for order status updates">
        <field name="orderId"      id="37"  type="OrderID"/>
        <field name="execId"       id="17"  type="ExecID"/>
        <field name="clOrdId"      id="11"  type="ClOrdID"/>
        <field name="quoteId"      id="117" type="QuoteID" description="Echoed if order originated from RFQ"/>
        <field name="execType"     id="150" type="ExecTypeEnum"/>
        <field name="ordStatus"    id="39"  type="OrdStatusEnum"/>
        <field name="symbol"       id="55"  type="Symbol"/>
        <field name="side"         id="54"  type="SideEnum"/>
        <field name="leavesQty"    id="151" type="int64" description="Remaining quantity, fixed-point 10^-8"/>
        <field name="cumQty"       id="14"  type="int64" description="Cumulative filled quantity, fixed-point 10^-8"/>
        <field name="avgPx"        id="6"   type="int64" description="Average fill price, fixed-point 10^-8"/>
        <field name="transactTime" id="60"  type="uint64"/>
        <field name="text"         id="58"  type="Text"/>
    </sbe:message>

    <!-- CancelOrderRequest: FIX 35=F -->
    <sbe:message name="CancelOrderRequest" id="6" semanticType="F"
                 description="Order cancel request">
        <field name="origClOrdId"  id="41"  type="OrigClOrdID" description="ClOrdId of the order to cancel"/>
        <field name="clOrdId"      id="11"  type="ClOrdID" description="New clOrdId for this cancel request"/>
        <field name="symbol"       id="55"  type="Symbol"/>
        <field name="side"         id="54"  type="SideEnum"/>
        <field name="transactTime" id="60"  type="uint64"/>
        <field name="account"      id="1"   type="Account"/>
    </sbe:message>

    <!-- MassQuote: FIX 35=i -->
    <sbe:message name="MassQuote" id="7" semanticType="i"
                 description="Mass quote with multiple quote entries">
        <field name="quoteId"      id="117" type="QuoteID" description="Unique mass quote identifier"/>
        <field name="account"      id="1"   type="Account"/>
        <field name="transactTime" id="60"  type="uint64"/>
        <group name="noQuoteEntries" id="295" dimensionType="groupSizeEncoding"
               description="Repeating group of quote entries">
            <field name="quoteEntryId" id="299" type="QuoteID" description="Per-entry identifier"/>
            <field name="symbol"       id="55"  type="Symbol"/>
            <field name="bidPx"        id="132" type="int64" description="Bid price, fixed-point 10^-8"/>
            <field name="offerPx"      id="133" type="int64" description="Offer price, fixed-point 10^-8"/>
            <field name="bidSize"      id="134" type="int64" description="Bid quantity, fixed-point 10^-8"/>
            <field name="offerSize"    id="135" type="int64" description="Offer quantity, fixed-point 10^-8"/>
        </group>
    </sbe:message>

</sbe:messageSchema>

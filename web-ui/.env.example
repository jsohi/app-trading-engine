# Trading Engine web-ui — copy to .env.local (gitignored) and fill in.
#
# AG Grid Enterprise license key. Without this the grid renders with a
# watermark — acceptable in dev and on fork PRs (no secret access).
# CI builds inject this via the AG_GRID_LICENSE secret.
VITE_AG_GRID_LICENSE=

# Set to "1" to force the @vitejs/plugin-basic-ssl fallback even if
# .dev-certs/cert.pem exists. Useful for testing the auto-self-signed
# path. Defaults to using mkcert PEMs when present.
VITE_FORCE_BASIC_SSL=

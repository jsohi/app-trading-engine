{
  "name": "@trading/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Trading Engine browser UI — Vite + React 19 + AG Grid Enterprise + RxJS.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fixtures": "eslint test/lint-fixtures --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e": "npm run e2e:install && playwright test",
    "e2e:smoke": "npm run e2e:install && playwright test --grep-invert @licensed",
    "e2e:licensed": "npm run e2e:install && playwright test --grep @licensed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.7.0",
    "@opentelemetry/sdk-trace-web": "2.7.0",
    "@trading/sbe-codecs": "*",
    "ag-grid-enterprise": "35.2.1",
    "ag-grid-react": "35.2.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser": "4.1.5",
    "@vitest/browser-playwright": "4.1.5",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.0",
    "mock-socket": "9.3.1",
    "storybook": "10.3.5",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  }
}
